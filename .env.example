# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional fallback for auth email redirects when Host headers are unavailable
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: disable Vercel Web Analytics (enabled by default on Vercel production)
# NEXT_PUBLIC_ANALYTICS_DISABLED=true

# Sentry — https://sentry.io (optional; leave blank to disable error reporting)
# NEXT_PUBLIC_SENTRY_DSN=
# Optional source-map upload in CI / production builds:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
